# Copia este archivo como .env en el servidor y rellénalo. NUNCA lo subas al repositorio ni lo pegues en un chat.

# Telegram: token de @BotFather y tu ID numérico (te lo da @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
MODELO_CLAUDE=claude-opus-5-5
ESFUERZO_CLAUDE=medium

# Supabase · Connect → Session pooler. Cambia el usuario por agente_lectura.<ref> / agente_registro.<ref>
DB_URL_AGENTE=postgresql://agente_lectura.btnkzxrkrqsgcuuxqtjd:CONTRASEÑA@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Opcional: si falta, el registro se guarda en registro/registro.jsonl
DB_URL_REGISTRO=postgresql://agente_registro.btnkzxrkrqsgcuuxqtjd:CONTRASEÑA@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# API para el futuro orquestador (opcional). Genera uno largo: python -c "import secrets;print(secrets.token_urlsafe(32))"
ORQUESTADOR_TOKEN=
API_HOST=127.0.0.1
API_PORT=8080

# Modo demo: congela la hora mientras no exista el alimentador diario (los datos terminan el 30/9/2026 11:30)
AGENTE_AHORA_FIJA=2026-09-30T11:30:00-04:00

LIMITE_CONSULTAS_HORA=30
HORA_RESUMEN=19:30
